{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/collect?slot=morning", "schedule": "0 21 * * *" },
    { "path": "/api/cron/collect?slot=noon", "schedule": "0 3 * * *" },
    { "path": "/api/cron/collect?slot=night", "schedule": "0 12 * * *" },
    { "path": "/api/cron/briefing", "schedule": "0 22 * * *" },
    { "path": "/api/cron/alerts", "schedule": "0 0 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 12 * * 0" }
  ],
  "functions": {
    "src/app/api/cron/**/*.ts": { "maxDuration": 300 },
    "src/app/api/**/*.ts": { "maxDuration": 60 }
  }
}
